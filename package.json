{
  "name": "rigup",
  "version": "0.1.0",
  "description": "The package manager for Claude Code. Like shadcn/ui, but for AI configs.",
  "type": "module",
  "bin": {
    "rigup": "./dist/index.js",
    "rig": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "agents",
    "skills",
    "hooks",
    "mcp",
    "package-manager",
    "cli"
  ],
  "author": "xeldar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/XeldarAlz/rigup"
  },
  "homepage": "https://github.com/XeldarAlz/rigup#readme",
  "bugs": {
    "url": "https://github.com/XeldarAlz/rigup/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "semver": "^7.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/semver": "^7.5.8",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
